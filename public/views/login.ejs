<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="login-card card">
  <h1>Pigeon Racing Organizer</h1>

  <form method="POST" action="/login">
    <p>
      <input
        type="text"
        name="username"
        placeholder="Username"
        required>
    </p>

    <p>
      <input
        type="password"
        name="password"
        placeholder="Password"
        required>
    </p>

    <button type="submit">
      Login
    </button>
  </form>

</div>

</body>
</html>
