<div class="container-fluid">
  <div class="row">

    <!-- Sidebar -->
    <div class="col-lg-2 bg-dark text-white min-vh-100 p-3">
      <h2>MPRPHC</h2>
      <hr>

      <a href="/dashboard" class="d-block text-white mb-3">Dashboard</a>
      <a href="/members" class="d-block text-white mb-3">Members</a>
      <a href="/pigeons" class="d-block text-white mb-3">Pigeons</a>
      <a href="/races" class="d-block text-white mb-3">Races</a>
      <a href="/results" class="d-block text-white mb-3">Results</a>
      <a href="/logout" class="d-block text-danger">Logout</a>
    </div>

    <!-- Main Content -->
    <div class="col-lg-10 p-4">

      <h2 class="mb-4">Dashboard Overview</h2>

      <div class="row">

        <div class="col-md-4 mb-3">
          <div class="card shadow p-3">
            <h6>Members</h6>
            <h1><%= members %></h1>
          </div>
        </div>

        <div class="col-md-4 mb-3">
          <div class="card shadow p-3">
            <h6>Pigeons</h6>
            <h1><%= pigeons %></h1>
          </div>
        </div>

        <div class="col-md-4 mb-3">
          <div class="card shadow p-3">
            <h6>Races</h6>
            <h1><%= races %></h1>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<a href="/admin/create-member" class="btn btn-success">
  Add Member Account
</a>

<% if(user.role === "organizer"){ %>

<a href="/members/new" class="btn btn-success">
Add Member / Loft
</a>

<% } %>
