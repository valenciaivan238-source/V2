<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MPRPHC Dashboard</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <style>

        body {
            margin: 0;
            background: #f4f6f9;
            font-family: Arial, sans-serif;
        }

        /* SIDEBAR */

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #111827;
            position: fixed;
            left: 0;
            top: 0;
            padding: 20px 15px;
            z-index: 1000;
        }

        .logo {
            color: white;
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 25px;
        }

        .logo small {
            display: block;
            color: #9ca3af;
            font-size: 11px;
            margin-top: 3px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #d1d5db;
            text-decoration: none;
            padding: 12px 14px;
            margin-bottom: 5px;
            border-radius: 8px;
            transition: 0.2s;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #2563eb;
            color: white;
        }

        .sidebar .logout {
            color: #f87171;
            margin-top: 20px;
        }

        /* MAIN */

        .main {
            margin-left: 250px;
            padding: 25px;
        }

        .topbar {
            background: white;
            padding: 18px 22px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .topbar h2 {
            margin: 0;
            font-weight: bold;
        }

        .topbar p {
            margin: 4px 0 0;
            color: #6b7280;
        }

        /* STAT CARDS */

        .stat-card {
            background: white;
            border-radius: 14px;
            padding: 22px;
            border: none;
            box-shadow: 0 3px 10px rgba(0,0,0,0.06);
            height: 100%;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            background: #e8f0ff;
            color: #2563eb;
        }

        .stat-card h6 {
            color: #6b7280;
            margin-top: 15px;
            margin-bottom: 5px;
        }

        .stat-card h1 {
            font-size: 34px;
            font-weight: bold;
            margin: 0;
        }

        /* SECTIONS */

        .section-card {
            background: white;
            border-radius: 14px;
            padding: 22px;
            margin-top: 25px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.06);
        }

        .section-title {
            font-weight: bold;
            margin-bottom: 18px;
        }

        /* QUICK BUTTONS */

        .quick-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 16px;
            border-radius: 9px;
            text-decoration: none;
            font-weight: 600;
        }

        /* MOBILE */

        .mobile-header {
            display: none;
        }

        @media (max-width: 991px) {

            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .mobile-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: #111827;
                color: white;
                padding: 15px;
                margin: -15px -15px 20px -15px;
            }

            .mobile-header h4 {
                margin: 0;
                font-weight: bold;
            }

            .mobile-menu {
                position: fixed;
                top: 0;
                left: -280px;
                width: 270px;
                height: 100vh;
                background: #111827;
                z-index: 2000;
                padding: 20px 15px;
                transition: 0.3s;
            }

            .mobile-menu.show {
                left: 0;
            }

            .mobile-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                color: #d1d5db;
                text-decoration: none;
                padding: 13px;
                border-radius: 8px;
                margin-bottom: 5px;
            }

            .mobile-menu a:hover {
                background: #2563eb;
                color: white;
            }

            .close-menu {
                color: white;
                font-size: 25px;
                margin-bottom: 20px;
            }

            .topbar {
                padding: 18px;
            }

            .topbar h2 {
                font-size: 22px;
            }

            .stat-card {
                margin-bottom: 15px;
            }

        }

    </style>
</head>

<body>


<!-- DESKTOP SIDEBAR -->

<div class="sidebar">

    <div class="logo">
        MPRPHC
        <small>Pigeon Racing Management</small>
    </div>

    <a href="/dashboard" class="active">
        <i class="bi bi-speedometer2"></i>
        Dashboard
    </a>

    <a href="/members">
        <i class="bi bi-people"></i>
        Members
    </a>

    <a href="/pigeons">
        <i class="bi bi-twitter"></i>
        Pigeons
    </a>

    <a href="/races">
        <i class="bi bi-flag"></i>
        Races
    </a>

    <a href="/results">
        <i class="bi bi-trophy"></i>
        Results
    </a>

    <a href="/logout" class="logout">
        <i class="bi bi-box-arrow-right"></i>
        Logout
    </a>

</div>


<!-- MOBILE HEADER -->

<div class="mobile-header">

    <h4>MPRPHC</h4>

    <button
        class="btn btn-dark"
        onclick="openMenu()"
        type="button"
    >
        <i class="bi bi-list fs-4"></i>
    </button>

</div>


<!-- MOBILE MENU -->

<div id="mobileMenu" class="mobile-menu">

    <div class="close-menu">

        <button
            class="btn btn-dark"
            onclick="closeMenu()"
            type="button"
        >
            <i class="bi bi-x-lg"></i>
        </button>

    </div>

    <h4 class="text-white mb-4">
        MPRPHC
    </h4>

    <a href="/dashboard">
        <i class="bi bi-speedometer2"></i>
        Dashboard
    </a>

    <a href="/members">
        <i class="bi bi-people"></i>
        Members
    </a>

    <a href="/pigeons">
        <i class="bi bi-twitter"></i>
        Pigeons
    </a>

    <a href="/races">
        <i class="bi bi-flag"></i>
        Races
    </a>

    <a href="/results">
        <i class="bi bi-trophy"></i>
        Results
    </a>

    <a href="/logout" class="text-danger">
        <i class="bi bi-box-arrow-right"></i>
        Logout
    </a>

</div>


<!-- MAIN -->

<div class="main">

    <!-- HEADER -->

    <div class="topbar">

        <h2>Dashboard Overview</h2>

        <p>
            Welcome to the MPRPHC Management System
        </p>

    </div>


    <!-- STATISTICS -->

    <div class="row">


        <!-- MEMBERS -->

        <div class="col-md-4 mb-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <h6>Members</h6>

                <h1>
                    <%= members %>
                </h1>

                <a
                    href="/members"
                    class="btn btn-outline-primary btn-sm mt-3"
                >
                    View Members
                </a>

            </div>

        </div>


        <!-- PIGEONS -->

        <div class="col-md-4 mb-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-twitter"></i>
                </div>

                <h6>Pigeons</h6>

                <h1>
                    <%= pigeons %>
                </h1>

                <a
                    href="/pigeons"
                    class="btn btn-outline-primary btn-sm mt-3"
                >
                    View Pigeons
                </a>

            </div>

        </div>


        <!-- RACES -->

        <div class="col-md-4 mb-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-flag-fill"></i>
                </div>

                <h6>Races</h6>

                <h1>
                    <%= races %>
                </h1>

                <a
                    href="/races"
                    class="btn btn-outline-primary btn-sm mt-3"
                >
                    View Races
                </a>

            </div>

        </div>

    </div>


    <!-- ADMIN / ORGANIZER -->

    <% if (
        user &&
        (user.role === "admin" || user.role === "organizer")
    ) { %>

        <div class="section-card">

            <h4 class="section-title">
                Management
            </h4>

            <div class="row g-2">

                <div class="col-md-6">

                    <a
                        href="/admin/create-member"
                        class="btn btn-success w-100 quick-btn"
                    >
                        <i class="bi bi-person-plus-fill"></i>
                        Add Member Account
                    </a>

                </div>


                <% if (user.role === "organizer") { %>

                    <div class="col-md-6">

                        <a
                            href="/members/new"
                            class="btn btn-primary w-100 quick-btn"
                        >
                            <i class="bi bi-house-add-fill"></i>
                            Add Member / Loft
                        </a>

                    </div>

                <% } %>

            </div>

        </div>

    <% } %>


    <!-- MEMBER -->

    <% if (user && user.role === "member") { %>

        <div class="section-card">

            <h4 class="section-title">
                My Race Entries
            </h4>

            <p class="text-muted">
                Manage your race entries and submit pigeon arrival.
            </p>

            <a
                href="/member/races"
                class="btn btn-primary quick-btn d-inline-flex"
            >
                <i class="bi bi-stopwatch"></i>
                Submit Pigeon Arrival
            </a>

        </div>

    <% } %>


</div>


<script>

function openMenu() {

    document
        .getElementById("mobileMenu")
        .classList
        .add("show");

}

function closeMenu() {

    document
        .getElementById("mobileMenu")
        .classList
        .remove("show");

}

</script>

</body>
</html>
