<% if(user && user.role === "organizer"){ %>

<a href="/pigeons/new"
class="btn btn-success mb-3">

Add Pigeon

</a>

<% } %>
<!DOCTYPE html>
<html>
<head>
    <title>Pigeons</title>
</head>
<body>

<h1>Pigeons</h1>

<table border="1">

<tr>
    <th>Ring No</th>
    <th>Name</th>
    <th>Owner</th>
</tr>

<% pigeons.forEach(p => { %>
<tr>
    <td><%= p.ring_no %></td>
    <td><%= p.name %></td>
    <td><%= p.owner %></td>
</tr>
<% }) %>

</table>

</body>
</html>
