<!DOCTYPE html>
<html>
<head>
    <title>Race Entries</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: left;
        }

        th {
            background: #f2f2f2;
        }

        input, select, button {
            padding: 10px;
            margin: 5px 0;
        }

        button {
            cursor: pointer;
        }

        .form-box {
            border: 1px solid #ccc;
            padding: 15px;
            margin-top: 20px;
        }

        .delete {
            color: red;
        }

        @media (max-width: 700px) {
            table {
                font-size: 13px;
            }

            th, td {
                padding: 6px;
            }

            input, select, button {
                width: 100%;
                box-sizing: border-box;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Race Entries</h1>

    <h2>
        <%= race.name %>
    </h2>

    <p>
        Date: <%= race.race_date || "N/A" %>
    </p>

    <hr>

    <!-- ADD PIGEON TO RACE -->

    <% if (user && (user.role === "organizer" || user.role === "admin")) { %>

        <div class="form-box">

            <h3>Add Pigeon to Race</h3>

            <form
                method="POST"
                action="/races/<%= race.id %>/entries"
            >

                <label>
                    Select Pigeon:
                </label>

                <select name="pigeon_id" required>

                    <option value="">
                        -- Select Pigeon --
                    </option>

                    <% pigeons.forEach(pigeon => { %>

                        <option value="<%= pigeon.id %>">
                            <%= pigeon.ring_no %>
                            -
                            <%= pigeon.name %>
                            -
                            <%= pigeon.owner %>
                        </option>

                    <% }) %>

                </select>

                <br>

                <label>
                    Verification Code:
                </label>

                <input
                    type="text"
                    name="verification_code"
                    maxlength="5"
                    minlength="5"
                    pattern="[0-9]{5}"
                    inputmode="numeric"
                    placeholder="Enter 5-digit code"
                    required
                >

                <br>

                <button type="submit">
                    Add Pigeon to Race
                </button>

            </form>

        </div>

    <% } %>


    <!-- ENTERED PIGEONS -->

    <h3>Entered Pigeons</h3>

    <% if (entries.length === 0) { %>

        <p>
            No pigeons have been entered in this race yet.
        </p>

    <% } else { %>

        <table>

            <tr>
                <th>Ring No.</th>
                <th>Pigeon</th>
                <th>Member No.</th>
                <th>Owner</th>
                <th>Verification Code</th>
                <th>Action</th>
            </tr>

            <% entries.forEach(entry => { %>

                <tr>

                    <td>
                        <%= entry.ring_no %>
                    </td>

                    <td>
                        <%= entry.pigeon_name %>
                    </td>

                    <td>
                        <%= entry.member_no %>
                    </td>

                    <td>
                        <%= entry.owner %>
                    </td>

<td>
    <% if (user && (user.role === "admin" || user.role === "organizer")) { %>
        <strong>
            <%= entry.verification_code || "N/A" %>
        </strong>
    <% } else { %>
        <span>Hidden</span>
    <% } %>
</td>                   

                    <td>

                        <% if (user && (user.role === "organizer" || user.role === "admin")) { %>

                            <form
    

                    <td>

                        <% if (user && (user.role === "organizer" || user.role === "admin")) { %>

                            <form
                                method="POST"
                                action="/races/<%= race.id %>/entries/<%= entry.id %>/delete"
                                onsubmit="return confirm('Remove this pigeon from the race?');"
                            >

                                <button
                                    type="submit"
                                    class="delete"
                                >
                                    Remove
                                </button>

                            </form>

                        <% } %>

                    </td>

                </tr>

            <% }) %>

        </table>

    <% } %>

    <br>

    <a href="/races">
        Back to Races
    </a>

</div>

</body>
</html>
